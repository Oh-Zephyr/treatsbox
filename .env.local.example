# Copy this to .env.local for local development. Neither file is committed.
#
# Leave POSTGRES_URL unset to use the local data/db.json file automatically —
# no database needed for plain local dev.
#
# To use the same Postgres/Supabase database as production locally, run:
#   vercel env pull .env.local
# from the project root (requires the Vercel CLI and being logged into the
# project). That downloads the real values Vercel already has configured.

# POSTGRES_URL=

# Long random string used to sign admin session cookies. Required in
# production; a development fallback is used if unset locally.
# ADMIN_JWT_SECRET=
